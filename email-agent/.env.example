# 이 템플릿은 루트 .env로 통합되었습니다.
# 권장: myAgent/.env.example를 복사해서 myAgent/.env를 사용하세요.

# Daum IMAP credentials
DAUM_EMAIL=your_id@daum.net
DAUM_APP_PASSWORD=your_app_password

# IMAP server settings (defaults are Daum)
DAUM_IMAP_HOST=imap.daum.net
DAUM_IMAP_PORT=993

# Optional mailbox names
MAILBOX_INBOX=INBOX
MAILBOX_SPAM=Spam
