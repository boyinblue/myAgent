# =====================================
# Project root environment template
# =====================================
# 이 파일을 복사해서 루트(.env)에 두고 사용하세요.
# 실제 .env는 절대 커밋하지 마세요.

# -----------------------------
# Telegram (chatbot/content-crawler)
# -----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=123456789

# -----------------------------
# LLM / AI
# -----------------------------
GOOGLE_EMAIL=your_id@google.com
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_APP_PASSWORD=your_16_digit_app_password_here

# -----------------------------
# Content-crawler
# -----------------------------
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# -----------------------------
# GitHub workflow dispatch / issue (AI_Skills)
# -----------------------------
# 비밀값은 토큰만 .env에 둡니다.
# repo/workflow/ref/labels/provider/model 등 비밀이 아닌 값은 content-crawler/config.json > autopilot 섹션에 두세요.
GITHUB_TOKEN=your_github_pat_with_actions_write

# -----------------------------
# Email-agent (Daum IMAP)
# -----------------------------
DAUM_EMAIL=your_id@daum.net
DAUM_APP_PASSWORD=your_app_password
